# Rendered by packaging/rpm/build.sh; edit aveecare-cli.spec.in, not the output.
Name:           aveecare-cli
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Command line tool for the AveeCare home care API
License:        MIT
URL:            https://github.com/aveecare/aveecare-cli
Source0:        %{url}/releases/download/v%{version}/aveecare-cli-%{version}.tar.gz
BuildArch:      noarch
# nodejs(engine) carries the plain Node.js version on Fedora, RHEL and openSUSE.
# The nodejs name does not: Fedora and RHEL give it epoch 1, so a bare
# "nodejs >= 18" would accept RHEL 9's Node.js 16.
BuildRequires:  nodejs(engine) >= 18
Requires:       nodejs(engine) >= 18

%description
The official command line tool for the AveeCare API. List, create and update
a home care agency's patients, visits, caregivers, invoices and more from the
terminal, cron jobs and shell scripts. Output is JSON, so it pipes straight
into jq.

%prep
%setup -q

%build
# The release tarball holds a ready-to-run bundle; there is nothing to compile.

%install
install -Dpm 0755 aveecare.cjs %{buildroot}%{_datadir}/%{name}/aveecare.cjs
install -Dpm 0644 aveecare.1 %{buildroot}%{_mandir}/man1/aveecare.1
install -d %{buildroot}%{_bindir}
ln -s ../share/%{name}/aveecare.cjs %{buildroot}%{_bindir}/aveecare

%check
# Proves the bundle runs on this distribution's Node.js.
test "$(node %{buildroot}%{_datadir}/%{name}/aveecare.cjs --version)" = "%{version}"

%files
%license LICENSE
%doc README.md CHANGELOG.md
%{_bindir}/aveecare
%{_datadir}/%{name}/
%{_mandir}/man1/aveecare.1*

%changelog
* @DATE@ @PACKAGER@ - @VERSION@-@RELEASE@
- Release @VERSION@.
